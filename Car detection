import cv2
image_path=input("Enter image path")
car_casscade=cv2.CascadeClassifier("haarcascade_car.xml")
img=cv2.imread(image_path)
if img is None:
    print("image not found")
else :
    gray=cv2.cvtColor(img,cv2.COLOR_BGR2GRAY)
    car=car_casscade.detectMultiScale(gray,1.1,2)
    for (x,y,w,h)in car:
        cv2.rectangle(img,(x,y),(x+w,y+h),(0,225,0),3)
    print("total cars detected",len(car))
    cv2.imshow("Cars detection",img)
    cv2.waitKey(0)
    cv2.destroyAllWindows()


